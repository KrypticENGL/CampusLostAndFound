generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ItemType {
  LOST
  FOUND
}

enum ItemStatus {
  OPEN
  RESOLVED
}

enum Category {
  ELECTRONICS
  DOCUMENTS
  ACCESSORIES
  BOOKS
  BAGS
  OTHER
}

enum ContactType {
  EMAIL
  PHONE
}

model Item {
  id           String      @id @default(cuid())
  itemType     ItemType
  status       ItemStatus  @default(OPEN)
  name         String
  category     Category
  location     String
  date         DateTime
  description  String
  contactName  String?
  contactType  ContactType
  contactValue String
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([itemType, status])
  @@index([category])
  @@index([date])
  @@index([createdAt])
  @@index([userId])
}

enum Role {
  STUDENT
  ADMIN
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(STUDENT)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  items        Item[]
  sessions     Session[]
}

/// Opaque login sessions. Only a SHA-256 hash of the cookie token is stored.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
