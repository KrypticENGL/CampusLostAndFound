# Supabase Postgres (Project Settings -> Database -> Connection string)
# Runtime queries. For serverless deploys use the Transaction pooler (port 6543) and append &pgbouncer=true
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"
# Migrations. Direct connection or Session pooler (port 5432)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"
